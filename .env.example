APP_NAME=CTons AMY
APP_ENV=development
DEBUG=true

MOCK_MODE=true

DATABASE_URL=postgresql+psycopg://amy:amy@localhost:5432/ctons_amy

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_MODEL=
OPENAI_IMAGE_MODEL=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
