LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

STORAGE_PATH=storage

LOG_LEVEL=INFO

TIMEZONE=Asia/Kolkata

WAKE_WORD_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TASK_DEFAULT_TIMEOUT_SECONDS=120
TASK_MAX_RETRIES=3